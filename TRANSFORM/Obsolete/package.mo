within TRANSFORM;
package Obsolete "Classes kept so that older models still work; do not use them in new models"
  extends Modelica.Icons.ObsoleteModel;
  annotation (Documentation(info="<html>
<p>Classes that have been replaced or retired. They are kept for at least one release so that models written for an
earlier version keep working, each with a note naming what replaces it, and are then removed. The conversion script
moves references to their old names here when a model is upgraded. The CHANGELOG says when each one goes.</p>
</html>"));
end Obsolete;
